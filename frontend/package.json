{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:main": "ng serve main --port 4200",
    "start:sidebar": "ng serve sidebar --port 4201",
    "start:topbar": "ng serve topbar --port 4202",
    "start": "concurrently \"npm run start:main\" \"npm run start:sidebar\" \"npm run start:topbar\"",
    "build:main": "ng build main --base-href /main/",
    "build:sidebar": "ng build sidebar --base-href /sidebar/",
    "build:topbar": "ng build topbar --base-href /topbar/",
    "build": "npm run build:main && npm run build:sidebar && npm run build:topbar",
    "watch": "ng build --watch --configuration development",
    "test": "shx rm -rf .angular && ng test",
    "test:ci": "shx rm -rf .angular && ng test --watch=false --browsers=ChromeHeadless"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.6",
    "@angular/common": "^21.2.8",
    "@angular/compiler": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/material": "^21.2.6",
    "@angular/platform-browser": "^21.2.8",
    "@angular/platform-browser-dynamic": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@ngrx/signals": "^21.0.0",
    "@ngrx/store": "^21.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "howler": "^2.2.4",
    "lucide-angular": "^0.577.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.8",
    "@angular/localize": "^21.2.17",
    "@types/howler": "^2.2.12",
    "@types/jasmine": "~5.1.15",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-packagr": "^21.2.2",
    "shx": "^0.4.0",
    "typescript": "~5.9.3"
  }
}
