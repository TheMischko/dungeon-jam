{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:main": "ng serve main --port 4200",
    "start:sidebar": "ng serve sidebar --port 4201",
    "start:topbar": "ng serve topbar --port 4202",
    "start": "concurrently \"npm run start:main\" \"npm run start:sidebar\" \"npm run start:topbar\"",
    "build:main": "ng build main --base-href /main/",
    "build:sidebar": "ng build sidebar --base-href /sidebar/",
    "build:topbar": "ng build topbar --base-href /topbar/",
    "build": "npm run build:main && npm run build:sidebar && npm run build:topbar",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:general": "shx rm -rf .angular && ng test general --watch=false",
    "test:main": "shx rm -rf .angular && ng test main --watch=false",
    "test:sidebar": "shx rm -rf .angular && ng test sidebar --watch=false",
    "test:topbar": "shx rm -rf .angular && ng test topbar --watch=false",
    "test:ci": "npm run test:general && npm run test:main && npm run test:sidebar && npm run test:topbar"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@lucide/angular": "^1.45.0",
    "@ngrx/signals": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "howler": "^2.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@angular/localize": "^22.1.6",
    "@types/howler": "^2.2.12",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.1.1",
    "shx": "^0.4.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
