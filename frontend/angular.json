{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "main": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true,
          "changeDetection": "OnPush"
        }
      },
      "root": "projects/main",
      "sourceRoot": "projects/main/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../build/main",
            "index": "projects/main/src/index.html",
            "browser": "projects/main/src/main.ts",
            "polyfills": ["zone.js", "@angular/localize/init"],
            "tsConfig": "projects/main/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/main/public"
              },
              {
                "glob": "**/*",
                "input": "projects/general/assets"
              },
              {
                "glob": "**/*",
                "input": "i18n",
                "output": "/assets/i18n"
              }
            ],
            "styles": [
              "projects/main/src/styles.scss",
              "projects/general/styles/global.scss"
            ],
            "scripts": [],
            "stylePreprocessorOptions": {
              "includePaths": ["projects/general/styles"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "main:build:production"
            },
            "development": {
              "buildTarget": "main:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "runnerConfig": "vitest.config.ts",
            "buildTarget": "main:build:development",
            "tsConfig": "projects/main/tsconfig.spec.json",
            "setupFiles": ["projects/general/src/test-setup.ts"],
            "providersFile": "projects/general/src/test-providers.ts"
          }
        }
      }
    },
    "sidebar": {
