{
  "name": "dungeon-jam",
  "version": "0.0.1",
  "author": "TheMischko",
  "private": true,
  "license": "ISC",
  "description": "",
  "main": "build/src/index.js",
  "scripts": {
    "copyfiles:basic": "copyfiles -f src/sound-capture/index.html build/src/sound-capture && copyfiles -f src/sound-capture/PCMStream.worklet.js build/src/sound-capture",
    "copyfiles:dev": "npm run copyfiles:basic && copyfiles -f .env build",
    "copyfiles:prod": "npm run copyfiles:basic && copyfiles -f .prod.env build && npx shx mv build/.prod.env build/.env",
    "build:frontend": "cd frontend && npm run build && cd ..",
    "build:electron": "node esbuild.config.mjs",
    "build:dir": "electron-builder --dir",
    "build:dist": "electron-builder",
    "compile:dev": "npm run build:electron && npm run copyfiles:dev && npm run build:frontend",
    "compile:prod": "npm run build:electron && npm run copyfiles:prod && npm run build:frontend",
    "start": "npm run build:electron && npm run copyfiles:dev && electron build/src/index.js",
    "start:frontend": "cd frontend && npm run start && cd ..",
    "test:frontend": "cd frontend && npm run test",
    "test:electron": "vitest run",
    "test:electron:watch": "vitest watch",
    "test:electron:coverage": "concurrently \"vitest watch --coverage\" \"vite preview --outDir ./coverage\"",
    "test:electron:preview": "vitest watch --ui ",
    "test": "npm run test:electron && cd frontend && npm run test -- --watch=false && cd ..",
    "test:watch": "concurrently \"npm run test:electron:watch\" \"cd frontend && npm run test && cd ..\"",
    "test:coverage": "npm run test:electron:coverage && cd frontend && npm run ng -- test --code-coverage --watch=false && cd .."
  },
  "build": {
    "appId": "com.dungeonjam.app",
    "productName": "Dungeon Jam",
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist-electron"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "build/src/sound-capture",
        "to": "sound-capture"
      }
    ],
    "asar": "true",
    "asarUnpack": [
      "**/node_modules/opusscript/**",
      "**/node_modules/prism-media/**",
      "**/node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "copyfiles": "^2.4.1",
    "discord-api-types": "^0.38.45",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "ffmetadata": "^1.7.0",
    "ffmpeg-static": "^5.3.0",
    "lowdb": "^7.0.1",
    "mime-types": "^3.0.2",
    "music-metadata": "^11.12.3",
    "opusscript": "^0.0.8",
    "picocolors": "^1.1.1",
    "prism-media": "^1.3.5",
    "typescript": "^6.0.2",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "esbuild-node-externals": "^1.22.0",
    "prettier": "^3.8.2",
    "shx": "^0.4.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
