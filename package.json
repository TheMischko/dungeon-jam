{
  "name": "dungeon-jam",
  "version": "0.0.6-alpha",
  "author": "TheMischko",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "",
  "main": "build/src/index.js",
  "scripts": {
    "copyfiles:basic": "copyfiles -f src/sound-capture/index.html build/src/sound-capture && copyfiles -f src/sound-capture/PCMStream.worklet.js build/src/sound-capture",
    "build:frontend": "cd frontend && npm run build && cd ..",
    "build:electron": "node esbuild.config.mjs",
    "build:electron:dev": "node esbuild.config.mjs --dev",
    "build:electron:prod": "node esbuild.config.mjs",
    "build:dir": "electron-builder --dir",
    "build:dist": "electron-builder",
    "rebuild:dir": "shx rm -rf build && npm run compile:prod && npm run build:dir",
    "compile:dev": "npm run build:electron:dev && npm run copyfiles:basic && npm run build:frontend",
    "compile:prod": "npm run build:electron:prod && npm run copyfiles:basic && npm run build:frontend",
    "start": "npm run build:electron:dev && npm run copyfiles:basic && electron build/src/index.js",
    "start:temp": "npm run build:electron:dev && npm run copyfiles:basic && electron build/src/index.js --temp-db",
    "start:frontend": "cd frontend && npm run start && cd ..",
    "test:frontend": "cd frontend && npm run test:ci",
    "test:electron": "vitest run",
    "test:electron:watch": "vitest watch",
    "test:electron:coverage": "concurrently \"vitest watch --coverage\" \"vite preview --outDir ./coverage\"",
    "test:electron:preview": "vitest watch --ui ",
    "test": "npm run test:electron && npm run test:frontend",
    "test:watch": "concurrently \"npm run test:electron:watch\" \"cd frontend && npm run test && cd ..\"",
    "test:coverage": "npm run test:electron:coverage && cd frontend && npm run ng -- test --code-coverage --watch=false && cd ..",
    "test:e2e": "cross-env TS_NODE_PROJECT=tests/tsconfig.test.json cucumber-js",
    "test:e2e-build": "npm run compile:prod && npm run test:e2e"
  },
  "build": {
    "appId": "com.dungeonjam.app",
    "productName": "Dungeon Jam",
    "publish": {
      "provider": "github",
      "owner": "TheMischko",
      "repo": "dungeon-jam",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist-electron"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "build/src/sound-capture",
        "to": "sound-capture"
      }
    ],
    "asar": "true",
    "asarUnpack": [
      "**/node_modules/opusscript/**",
      "**/node_modules/prism-media/**",
      "**/node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "copyfiles": "^2.4.1",
    "discord-api-types": "^0.38.55",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "ffmetadata": "^1.7.0",
    "ffmpeg-static": "^5.3.0",
    "lowdb": "^7.0.1",
    "mime-types": "^3.0.2",
    "music-metadata": "^11.15.0",
    "opusscript": "^0.0.8",
    "picocolors": "^1.1.1",
    "prism-media": "^1.3.5",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.5.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "cucumber-tsflow": "^4.6.1",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "esbuild-node-externals": "^1.23.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
